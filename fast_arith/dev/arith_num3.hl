(* -------------------------------------------------------------------------- *)
(* Formal natural arithmetic with an arbitrary base (optimized)               *)
(* -------------------------------------------------------------------------- *)

module type Arith_num3_sig =
  sig
    val arith_base : int
    val const_array : term array
    val def_array: thm array
    val def_thm_array: thm array
    val mk_nat : num -> term
    val mk_small_nat : int -> term
    val dest_nat : term -> num
    val NUMERAL_TO_NUM_CONV : term -> thm

    val nsuc : term -> thm
    val npre : term -> thm

    val neven : term -> thm
    val nodd : term -> thm
    val neq0 : term -> thm * bool
    val ngt0 : term -> thm * bool
    val neq : term -> term -> thm
    val nlt : term -> term -> thm
    val nle : term -> term -> thm

    (* val nmax : term -> term -> thm
    val nmin : term -> term -> thm *)

    val nadd : term -> term -> thm
    val nsub : term -> term -> thm
    val nsub_le : term -> term -> thm * thm * bool
    val nmul : term -> term -> thm
    val ndiv : term -> term -> thm

end;;

(* Dependencies *)
needs "misc/misc_functions.hl";;
needs "misc/misc_vars.hl";;
needs "arith_options.hl";;

module Arith_num3 : Arith_num3_sig = struct

open Misc_functions;;
open Misc_vars;;

let arith_base = !Arith_options.base;;
let maximum = arith_base;;

(******************)

(* Generate definitions and constants *)

let fnum_type = `:num->num` and
    numeral_const = `NUMERAL` and
    bit0_const = `BIT0` and
    bit1_const = `BIT1`;;

(* Names of constants which define "digits" *)
let names_array = Array.init maximum (fun i -> "B"^(string_of_int i));;

(* Fast, safe extraction of the integer index i from digit constant D_i *)
let digit_id tm =
  let s = fst (dest_const tm) in
  let len = String.length s in
  if len = 2 then
    Char.code s.[1] - 48
  else if len = 3 then
    (Char.code s.[1] - 48) * 10 + (Char.code s.[2] - 48)
  else if len = 4 then
    (Char.code s.[1] - 48) * 100 + (Char.code s.[2] - 48) * 10 + (Char.code s.[3] - 48)
  else
    int_of_string (String.sub s 1 (len - 1));;

(* |- D_i(n) = i + D_0(n) *)
let mk_bit_definition i =
  let lhs = mk_var (names_array.(i), fnum_type) in
  let tm1 = mk_binop mul_op_num (mk_small_numeral arith_base) n_var_num in
  let tm2 = mk_binop add_op_num tm1 (mk_small_numeral i) in
  let rhs = mk_abs (n_var_num, tm2) in
    new_basic_definition (mk_eq (lhs, rhs));;

let def_basic_array = Array.init maximum mk_bit_definition;;
let def_array = Array.init maximum (fun i ->
                                      let basic = def_basic_array.(i) in
                                      let th1 = AP_THM basic n_var_num in
                                        TRANS th1 (BETA (rand (concl th1))));;
let def_table = Hashtbl.create maximum;;

for i = 0 to maximum - 1 do
  Hashtbl.add def_table names_array.(i) def_array.(i)
done;;


(* Constants *)
let const_array = Array.init maximum (fun i -> mk_const(names_array.(i),[]));;
let dj0_array = Array.init maximum (fun i -> mk_comb(const_array.(i), zero_const));;

let b0_def = def_array.(0);;
let b0_const = const_array.(0);;
let b0_name = names_array.(0);;

let max_const = mk_small_numeral maximum;;


(* Alternative definition of D_i *)
let ADD_0_n = prove(`_0 + n = n`,
                    ONCE_REWRITE_TAC[GSYM NUMERAL] THEN
                      REWRITE_TAC[GSYM ARITH_ADD; ADD_CLAUSES]);;
let ADD_n_0 = prove(`n + _0 = n`,
                    ONCE_REWRITE_TAC[GSYM NUMERAL] THEN
                      REWRITE_TAC[GSYM ARITH_ADD; ADD_CLAUSES]);;

let MUL_n_0 = prove(`n * _0 = 0`,
        REWRITE_TAC[NUMERAL] THEN
          SUBGOAL_THEN `_0 = 0` MP_TAC THENL [ REWRITE_TAC[NUMERAL]; ALL_TAC ] THEN
                      DISCH_THEN (fun th -> ONCE_REWRITE_TAC[th]) THEN
          ARITH_TAC);;
    
(* D_i(n) = i + D_0(n) *)
let def_thm i =
  let bin = mk_comb(const_array.(i), n_var_num) in
  let bi0 = dj0_array.(i) in
  let b0n = mk_comb(const_array.(0), n_var_num) in
  let rhs = mk_binop add_op_num bi0 b0n in
    prove(mk_eq(bin, rhs), REWRITE_TAC[def_array.(i); def_array.(0)] THEN
            REWRITE_TAC[MUL_n_0; ADD_CLAUSES; ADD_AC]);;

let def_thm_array = Array.init maximum def_thm;;

let B0_0 = prove(mk_eq(mk_comb(b0_const, zero_const), zero_const),
                 REWRITE_TAC[b0_def; MUL_n_0; ADD_CLAUSES; NUMERAL]);;

let B0_EXPLICIT = prove(mk_eq(mk_comb(b0_const, n_var_num),
                              mk_binop mul_op_num max_const n_var_num),
                        REWRITE_TAC[b0_def; ADD_CLAUSES]);;
 
(******************************)
(* mk_numeral and dest_numeral *)

let max_num = Num.num_of_int maximum;;
let dest_num_array = Array.init maximum Num.num_of_int;;

let rec mk_nat n =
  if (n =/ num_0) then
    zero_const
  else
    let q = quo_num n max_num in
    let m = Num.int_of_num (n -/ (q */ max_num)) in
    let bit = const_array.(m) in
      mk_comb(bit, mk_nat q);;

let rec mk_small_nat n =
  if (n = 0) then zero_const
  else
    let m = n mod maximum in
    let bit = const_array.(m) in
      mk_comb(bit, mk_small_nat (n / maximum));;

(* dest_numeral *)
let rec dest_nat tm =
  if tm = zero_const then
    num_0
  else
    let l, r = dest_comb tm in
    let i = digit_id l in
    if r = zero_const then
      dest_num_array.(i)
    else
      let n = max_num */ dest_nat r in
      if i = 0 then n else n +/ dest_num_array.(i);;

(******************************)
(* NUMERAL_TO_NUM_CONV: coverts usual HOL numerals into k-bit numerals *)

let th_num_conv = Array.init maximum (fun i -> (SYM o SPEC_ALL) def_array.(i));;
let mod_op_num = `MOD`;;

let DIV_BASE = 
  let h1 = mk_eq(mk_binop div_op_num m_var_num max_const, q_var_num) in
  let h2 = mk_eq(mk_binop mod_op_num m_var_num max_const, r_var_num) in
  let c = mk_eq(m_var_num, mk_binop add_op_num (mk_binop mul_op_num max_const q_var_num) r_var_num) in
    (UNDISCH_ALL o ARITH_RULE) (mk_imp(h1, mk_imp(h2, c)));;

let ZERO_EQ_ZERO = (EQT_ELIM o REWRITE_CONV[NUMERAL]) `0 = _0`;;
let SYM_ZERO_EQ_ZERO = SYM ZERO_EQ_ZERO;;

let NUMERAL_TO_NUM_CONV tm =
  let rec raw_conv tm =
    if (rand tm = zero_const) then
      ZERO_EQ_ZERO
    else
      let th_div = NUM_DIV_CONV (mk_binop div_op_num tm max_const) in
      let th_mod = NUM_MOD_CONV (mk_binop mod_op_num tm max_const) in
      let q_tm = rand(concl th_div) in
      let r_tm = rand(concl th_mod) in
      let th0 = INST[tm, m_var_num; q_tm, q_var_num; r_tm, r_var_num] DIV_BASE in
      let th1 = MY_PROVE_HYP th_mod (MY_PROVE_HYP th_div th0) in
      let r = dest_small_numeral r_tm in
      let th2 = INST[q_tm, n_var_num] th_num_conv.(r) in
      let th = TRANS th1 th2 in
      let ltm, rtm = dest_comb(rand(concl th)) in
      let r_th = raw_conv rtm in
      TRANS th (AP_TERM ltm r_th) in

    if (fst o dest_const o rator) tm <> "NUMERAL" then
      failwith "NUMERAL_TO_NUM_CONV"
    else
      raw_conv tm;;

let replace_numerals = rand o concl o DEPTH_CONV NUMERAL_TO_NUM_CONV;;
let REPLACE_NUMERALS = CONV_RULE (DEPTH_CONV NUMERAL_TO_NUM_CONV);;

(* NUM_TO_NUMERAL_CONV *)
let NUM_TO_NUMERAL_CONV =
  let rec raw_conv tm =
    if tm = zero_const then
      SYM_ZERO_EQ_ZERO
    else
      let b_tm, n_tm = dest_comb tm in
      let n_th = raw_conv n_tm in
      let n_tm' = rand(concl n_th) in
      let cb = (fst o dest_const) b_tm in
      let th0 = Hashtbl.find def_table cb in
      let th1 = AP_TERM b_tm n_th in
      let th2 = TRANS th1 (INST[n_tm', n_var_num] th0) in
      let ltm, rtm = dest_comb(rand(concl th2)) in
      let mul_th = NUM_MULT_CONV (rand ltm) in
      let add_th0 = AP_THM (AP_TERM add_op_num mul_th) rtm in
      let add_th = TRANS add_th0 (NUM_ADD_CONV (rand(concl add_th0))) in
      TRANS th2 add_th in
  raw_conv;;

(*************************)
(* SUC_CONV *)

(* Theorems *)
let SUC_0 = prove(mk_eq(`SUC _0`, mk_comb (const_array.(1), zero_const)),
                  REWRITE_TAC[def_array.(1); MUL_n_0; ARITH_SUC; NUMERAL; ARITH_ADD]);;

let suc_th i =
  let cflag = (i + 1 >= maximum) in
  let suc = if (cflag) then 0 else i + 1 in
  let lhs = mk_comb(suc_op_num, (mk_comb (const_array.(i), n_var_num))) in
  let rhs = mk_comb(const_array.(suc),
                    if (cflag) then mk_comb(suc_op_num, n_var_num) else n_var_num) in
  let proof = REWRITE_TAC [def_array.(i); def_array.(suc)] THEN ARITH_TAC in
    prove(mk_eq(lhs, rhs), proof);;

let th_suc_array = Array.init maximum suc_th;;
let SUC_MAX = th_suc_array.(maximum - 1);;

let th_suc_0_array = Array.init maximum (fun i ->
  let th = INST [zero_const, n_var_num] th_suc_array.(i) in
  if i = maximum - 1 then
    TRANS th (AP_TERM b0_const SUC_0)
  else
    th);;

(* Conversion *)
let rec raw_suc_arg otm =
  if (otm = zero_const) then
    SUC_0
  else
    let btm, ntm = dest_comb otm in
    let i = digit_id btm in
    if (ntm = zero_const) then
      th_suc_0_array.(i)
    else if (i = maximum - 1) then
      let th = INST [ntm, n_var_num] SUC_MAX in
      TRANS th (AP_TERM b0_const (raw_suc_arg ntm))
    else
      INST [ntm, n_var_num] th_suc_array.(i);;

let nsuc = raw_suc_arg;;

(**************************************)
(* EQ_0_CONV *)
let EQ_B0_0 = prove(mk_eq(mk_eq(mk_comb(b0_const, n_var_num), `_0`), `n = _0`),
        REWRITE_TAC[b0_def; ADD_CLAUSES; NUMERAL; REWRITE_RULE[NUMERAL] MULT_EQ_0; ARITH_EQ]);;

let EQ_0_0 = prove(`_0 = _0 <=> T`, REWRITE_TAC[ARITH_EQ]);;

let eq_0_lemma = REWRITE_RULE[NUMERAL] (ARITH_RULE `a + b = 0 <=> a = 0 /\ b = 0`);;

let eq_0_i i =
  let concl = mk_eq(mk_eq(mk_comb(const_array.(i), n_var_num), zero_const), f_const) in
    prove(concl, REWRITE_TAC[def_array.(i); eq_0_lemma; NUMERAL; ARITH_EQ]);;

let th_eq0_array = Array.init maximum (fun i -> if (i = 0) then (EQ_0_0, true) else (eq_0_i i, false));;
let th_eq0_0_array = Array.init maximum (fun i ->
  if (i = 0) then
    TRANS (INST[zero_const, n_var_num] EQ_B0_0) EQ_0_0, true
  else
    let th, flag = th_eq0_array.(i) in
    INST[zero_const, n_var_num] th, flag);;

let rec raw_eq0_hash_conv rtm =
  if (rtm = zero_const) then
    EQ_0_0, true
  else
    let b_tm, n_tm = dest_comb rtm in
    let i = digit_id b_tm in
    if (n_tm = zero_const) then
      th_eq0_0_array.(i)
    else if (i = 0) then
      let th0 = INST[n_tm, n_var_num] EQ_B0_0 in
      let th1, flag = raw_eq0_hash_conv n_tm in
      TRANS th0 th1, flag
    else
      let th, flag = th_eq0_array.(i) in
      INST[n_tm, n_var_num] th, flag;;

let neq0 = raw_eq0_hash_conv;;

(**************************************)
(* PRE_CONV *)

(* Theorems *)
let PRE_0 = prove(`PRE _0 = _0`, 
      MP_TAC (CONJUNCT1 PRE) THEN SIMP_TAC[NUMERAL]);;

let PRE_B1_0 = prove(mk_eq(mk_comb(`PRE`, mk_comb(const_array.(1), `_0`)), `_0`),
         REWRITE_TAC[def_array.(1); MUL_n_0; ARITH_ADD; NUMERAL; ARITH_PRE; ARITH_EQ]);;


let PRE_B0_n0 = (UNDISCH_ALL o prove)(mk_imp(`n = _0 <=> T`, 
         mk_eq(mk_comb(`PRE`, mk_comb(b0_const, `n:num`)), `_0`)),
              REWRITE_TAC[B0_EXPLICIT] THEN 
          DISCH_THEN (fun th -> REWRITE_TAC[th; MUL_n_0]) THEN
          REWRITE_TAC[NUMERAL; ARITH_PRE]);;

let bmax_const = const_array.(maximum - 1);;

let PRE_B0_chained =
  let hyp_tm = mk_eq(mk_comb(pre_op_num, n_var_num), mk_comb(bmax_const, m_var_num)) in
  let concl_tm = mk_eq(mk_comb(pre_op_num, mk_comb(b0_const, n_var_num)),
                       mk_comb(bmax_const, mk_comb(bmax_const, m_var_num))) in
  (UNDISCH_ALL o prove)(mk_imp(hyp_tm, concl_tm),
    REWRITE_TAC[B0_EXPLICIT; def_array.(maximum - 1)] THEN ARITH_TAC);;

let PRE_lemma = (UNDISCH_ALL o ARITH_RULE) `SUC m = n ==> PRE n = m`;;

let pre_th i =
  let pre = i - 1 in
  let pre_tm = mk_comb(const_array.(pre), n_var_num) in
  let suc_th = raw_suc_arg pre_tm in
  let n_tm = rand(concl suc_th) in
  let th0 = INST[pre_tm, m_var_num; n_tm, n_var_num] PRE_lemma in
    MY_PROVE_HYP suc_th th0;;

let th_pre_array = Array.init maximum (fun i -> if i = 0 then REFL `_0` else pre_th i);;
let th_pre_0_array = Array.init maximum (fun i ->
  if i = 0 then REFL `_0`
  else if i = 1 then PRE_B1_0
  else INST [zero_const, n_var_num] th_pre_array.(i));;

(* |- PRE (D_0 (D_j n)) = D_{max-1} (D_{j-1} n) for j >= 1 *)
let pre_b0_th j =
  if j = 0 then REFL `_0`
  else
    let pre_tm = mk_comb(bmax_const, mk_comb(const_array.(j - 1), n_var_num)) in
    let suc_th = raw_suc_arg pre_tm in
    let n_tm = rand(concl suc_th) in
    let th0 = INST[pre_tm, m_var_num; n_tm, n_var_num] PRE_lemma in
      MY_PROVE_HYP suc_th th0;;

let th_pre_b0_array = Array.init maximum pre_b0_th;;

(* |- PRE (D_0 (D_1 _0)) = D_{max-1} _0 *)
let PRE_B0_B1_0 =
  let pre_tm = dj0_array.(maximum - 1) in
  let suc_th = raw_suc_arg pre_tm in
  let n_tm = rand(concl suc_th) in
  let th0 = INST[pre_tm, m_var_num; n_tm, n_var_num] PRE_lemma in
    MY_PROVE_HYP suc_th th0;;

let th_pre_b0_0_array = Array.init maximum (fun j ->
  if j = 0 then REFL `_0`
  else if j = 1 then PRE_B0_B1_0
  else INST [zero_const, n_var_num] th_pre_b0_array.(j));;

(* Conversion *)
let rec raw_pre_arg otm =
  if (otm = zero_const) then
    PRE_0
  else
    let btm, ntm = dest_comb otm in
    let i = digit_id btm in
    if (i = 0) then
      if (ntm = zero_const) then
        let th = INST[zero_const, n_var_num] PRE_B0_n0 in
        MY_PROVE_HYP EQ_0_0 th
      else
        let b2_tm, m_tm = dest_comb ntm in
        let j = digit_id b2_tm in
        if (j > 0) then
          if (m_tm = zero_const) then
            th_pre_b0_0_array.(j)
          else
            INST[m_tm, n_var_num] th_pre_b0_array.(j)
        else
          let th_n = raw_pre_arg ntm in
          let rhs_n = rand(concl th_n) in
          if (rhs_n = zero_const) then
            let n_th, _ = raw_eq0_hash_conv ntm in
            let th = INST[ntm, n_var_num] PRE_B0_n0 in
            MY_PROVE_HYP n_th th
          else
            let q_tm = rand rhs_n in
            let th0 = INST[ntm, n_var_num; q_tm, m_var_num] PRE_B0_chained in
            MY_PROVE_HYP th_n th0
    else if (ntm = zero_const) then
      th_pre_0_array.(i)
    else
      INST [ntm, n_var_num] th_pre_array.(i);;

let npre = raw_pre_arg;;

(**************************************)
(* GT0_CONV *)

let gt0_0 = prove(`_0 < _0 <=> F`, REWRITE_TAC[ARITH_LT]);;
let gt0_b0 = (REWRITE_RULE[NUMERAL] o prove)(mk_eq (mk_binop lt_op_num `0` (mk_comb(b0_const, n_var_num)), `0 < n`),
       REWRITE_TAC[b0_def] THEN ARITH_TAC);;

let gt0_th i =
  let bi = const_array.(i) in
  let concl = mk_eq (mk_binop lt_op_num zero_num (mk_comb(bi, n_var_num)), t_const) in
  let proof = REWRITE_TAC[def_array.(i)] THEN ARITH_TAC in
    (PURE_REWRITE_RULE[NUMERAL] o prove)(concl, proof);;

let th_gt0_array = Array.init maximum (fun i -> if i = 0 then gt0_0, false else gt0_th i, true);;
let th_gt0_0_array = Array.init maximum (fun i ->
  if i = 0 then
    TRANS (INST[zero_const, n_var_num] gt0_b0) gt0_0, false
  else
    let th, flag = th_gt0_array.(i) in
    INST[zero_const, n_var_num] th, flag);;

let rec raw_gt0_hash_conv rtm =
  if (rtm = zero_const) then
    gt0_0, false
  else
    let b_tm, n_tm = dest_comb rtm in
    let i = digit_id b_tm in
    if (n_tm = zero_const) then
      th_gt0_0_array.(i)
    else if (i = 0) then
      let th0 = INST[n_tm, n_var_num] gt0_b0 in
      let th1, flag = raw_gt0_hash_conv n_tm in
      TRANS th0 th1, flag
    else
      let th, flag = th_gt0_array.(i) in
      INST[n_tm, n_var_num] th, flag;;

let ngt0 = raw_gt0_hash_conv;;

(*************************************)
(* EQ *)

let EQ_REFL_T = prove(`(n:num = n) <=> T`, REWRITE_TAC[]);;

(* EQ tables *)

(* Generates the theorem |- D_i(m) = D_j(n) <=> F if i <> j and D_i(m) = D_i(n) <=> m = n *)
let gen_bi_eq_bj =
  let aux_th = prove(`i < b /\ j < b /\ ~(i = j) ==> ~(b * m + i = b * n + j:num)`,
         ONCE_REWRITE_TAC[ARITH_RULE `b * m + i = b * n + j <=> m * b + i = n * b + j:num`] THEN
           STRIP_TAC THEN POP_ASSUM MP_TAC THEN
           SUBGOAL_THEN `~(b = 0)` ASSUME_TAC THENL [POP_ASSUM MP_TAC THEN ARITH_TAC; ALL_TAC] THEN
           REWRITE_TAC[CONTRAPOS_THM] THEN
           DISCH_TAC THEN FIRST_ASSUM (MP_TAC o AP_TERM `\x. x DIV b`) THEN REWRITE_TAC[] THEN
           FIRST_ASSUM (MP_TAC o MATCH_MP (CONJUNCT1 DIV_MULT_ADD)) THEN
           DISCH_THEN (fun th -> REWRITE_TAC[th]) THEN
           SUBGOAL_THEN `i DIV b = 0 /\ j DIV b = 0` (fun th -> REWRITE_TAC[th]) THENL
       [
         FIRST_ASSUM (ASSUME_TAC o MATCH_MP DIV_EQ_0) THEN ASM_REWRITE_TAC[];
         ALL_TAC
       ] THEN
       REWRITE_TAC[ADD_0] THEN DISCH_TAC THEN
       UNDISCH_TAC `m * b + i = n * b + j:num` THEN
       ASM_REWRITE_TAC[] THEN ARITH_TAC) in
    fun i j ->
      let bi_m = mk_comb (const_array.(i), m_var_num) in
      let bj_n = mk_comb (const_array.(j), n_var_num) in
      let eq_tm = mk_binop eq_op_num bi_m bj_n in
  if i = j then
    prove (mk_eq (eq_tm, mk_binop eq_op_num m_var_num n_var_num), REWRITE_TAC[def_array.(i)] THEN ARITH_TAC)
  else
    prove (mk_eq (eq_tm, f_const), REWRITE_TAC[def_array.(i); def_array.(j)] THEN
       MATCH_MP_TAC aux_th THEN CONV_TAC NUM_REDUCE_CONV);;


let gen_next_eq_thm =
  let suc_eq_th = ARITH_RULE `SUC m = SUC n <=> m = n` in
    fun th ->
      let ltm, n_tm = (dest_comb o lhand o concl) th in
      let m_tm = rand ltm in
      let th0 = INST[m_tm, m_var_num; n_tm, n_var_num] suc_eq_th in
      let suc_m = raw_suc_arg m_tm in
      let suc_n = raw_suc_arg n_tm in
      let th1 = SYM (MK_COMB ((AP_TERM eq_op_num suc_m), suc_n)) in
  TRANS (TRANS th1 th0) th;;


let th_eq_array = Array.make (maximum * maximum) (REFL zero_const);;

for i = 0 to maximum - 1 do
  let sym = INST[n_var_num, m_var_num; m_var_num, n_var_num] o CONV_RULE (LAND_CONV SYM_CONV) in
  let th = ref (gen_bi_eq_bj 0 i) in
  let _ = th_eq_array.(i) <- !th in
  let _ = if i > 0 then
    th_eq_array.(i * maximum) <- sym !th
  else () in
    for k = 1 to maximum - i - 1 do
      let x = k and y = i + k in
      let _ = th := gen_next_eq_thm (!th) in
      let _ = th_eq_array.(x * maximum + y) <- !th in
      if y > x then
        th_eq_array.(y * maximum + x) <- sym !th
      else
        ()
    done;
done;;

let th_eq_00_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  if i = j then
    INST [dj0_array.(i), n_var_num] EQ_REFL_T
  else
    INST [zero_const, m_var_num; zero_const, n_var_num] th_eq_array.(idx));;


(* Conversion *)

let eq_0_sym = (REWRITE_RULE[NUMERAL] o prove)(`0 = n <=> n = 0`, REWRITE_TAC[EQ_SYM_EQ]);;

let rec raw_eq_args ltm rtm =
  if is_const rtm then
    (* n = _0 *)
    fst (raw_eq0_hash_conv ltm)
  else if is_const ltm then
    (* m = _0 *)
    let th0, _ = raw_eq0_hash_conv rtm in
    let th1 = INST[rtm, n_var_num] eq_0_sym in
    TRANS th1 th0
  else
    (* m <> _0, n <> _0 *)
    let bm_tm, m_tm = dest_comb ltm in
    let bn_tm, n_tm = dest_comb rtm in
    let i = digit_id bm_tm in
    let j = digit_id bn_tm in
    let idx = i * maximum + j in
    if m_tm = zero_const && n_tm = zero_const then
      th_eq_00_array.(idx)
    else
      let th0 = INST[m_tm, m_var_num; n_tm, n_var_num] th_eq_array.(idx) in
      if i <> j then
        th0
      else
        let th1 = raw_eq_args m_tm n_tm in
        TRANS th0 th1;;

let neq ltm rtm =
  if ltm = rtm then
    INST[ltm, n_var_num] EQ_REFL_T
  else
    raw_eq_args ltm rtm;;

(*************************************)
(* LT and LE *)

let LT_n_0 = prove(`n < _0 <=> F`, 
       SUBGOAL_THEN `_0 = 0` MP_TAC THENL [ REWRITE_TAC[NUMERAL]; ALL_TAC ] THEN
           DISCH_THEN (fun th -> PURE_ONCE_REWRITE_TAC[th]) THEN
           ARITH_TAC);;

let LE_0_n = prove(`_0 <= n <=> T`,
       SUBGOAL_THEN `_0 = 0` MP_TAC THENL [ REWRITE_TAC[NUMERAL]; ALL_TAC ] THEN
           DISCH_THEN (fun th -> PURE_ONCE_REWRITE_TAC[th]) THEN
           ARITH_TAC);;

let LT_REFL_F = prove(`(n:num < n) <=> F`, ARITH_TAC);;
let LE_REFL_T = prove(`(n:num <= n) <=> T`, ARITH_TAC);;

let LT_0_0 = INST[zero_const, n_var_num] LT_n_0;;
let LE_0_0 = INST[zero_const, n_var_num] LE_0_n;;

let SUC_LT_THM = ARITH_RULE `SUC m < SUC n <=> m < n`;;
let SUC_LE_THM = ARITH_RULE `SUC m <= SUC n <=> m <= n`;;

(* LT tables *)

(* Generates the theorem |- _0 < bi(n) <=> T (or |- _0 < b0(n) <=> _0 < n) *)
let gen_0_lt_bi i =
  let bin = mk_comb (const_array.(i), n_var_num) in
  let lt_tm = mk_binop lt_op_num zero_num bin in
    if i > 0 then
      (PURE_REWRITE_RULE[NUMERAL] o EQT_INTRO o prove)(lt_tm, REWRITE_TAC[def_array.(i)] THEN ARITH_TAC)
    else
      (PURE_REWRITE_RULE[NUMERAL] o prove)(mk_eq(lt_tm, `0 < n`), REWRITE_TAC[B0_EXPLICIT] THEN ARITH_TAC);;

let th_lt0_array = Array.init maximum gen_0_lt_bi;;
let th_lt0_0_array = Array.init maximum (fun i ->
  if i = 0 then
    TRANS (INST[zero_const, n_var_num] th_lt0_array.(0)) LT_0_0
  else
    INST[zero_const, n_var_num] th_lt0_array.(i));;


(* Generates the theorem |- bi(m) < bj(n) <=> m <= n (or m < n) *)
let gen_bi_lt_bj i j =
  let bim = mk_comb (const_array.(i), m_var_num) in
  let bjn = mk_comb (const_array.(j), n_var_num) in
  let lt_tm = mk_binop lt_op_num bim bjn in
  let rhs = 
    if i >= j then
      mk_binop lt_op_num m_var_num n_var_num 
    else
      mk_binop le_op_num m_var_num n_var_num in
    prove(mk_eq(lt_tm, rhs), REWRITE_TAC[def_array.(i); def_array.(j)] THEN ARITH_TAC);;

(* Given a theorem |- bi(m) < bj(n) <=> P m n, generates the theorem
   |- SUC(bi(m)) < SUC(bj(n)) <=> P m n *)
let gen_next_lt_thm th =
  let ltm, n_tm = (dest_comb o lhand o concl) th in
  let m_tm = rand ltm in
  let th0 = INST[m_tm, m_var_num; n_tm, n_var_num] SUC_LT_THM in
  let suc_m = raw_suc_arg m_tm in
  let suc_n = raw_suc_arg n_tm in
  let th1 = SYM (MK_COMB ((AP_TERM lt_op_num suc_m), suc_n)) in
    TRANS (TRANS th1 th0) th;;

let th_lt_array = Array.make (maximum * maximum) (REFL zero_const);;

for i = 0 to maximum - 1 do
  let th = ref (gen_bi_lt_bj 0 i) in
  let _ = th_lt_array.(i) <- !th in

    for k = 1 to maximum - i - 1 do
      let x = k and y = i + k in
      th := gen_next_lt_thm (!th);
      th_lt_array.(x * maximum + y) <- !th
    done;
done;;

for i = 1 to maximum - 1 do
  let th = ref (gen_bi_lt_bj i 0) in
  let _ = th_lt_array.(i * maximum) <- !th in

    for k = 1 to maximum - i - 1 do
      let x = i + k and y = k in
      th := gen_next_lt_thm (!th);
      th_lt_array.(x * maximum + y) <- !th
    done;
done;;

let th_lt_00_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  let th0 = INST[zero_const, m_var_num; zero_const, n_var_num] th_lt_array.(idx) in
  let th1 = if i >= j then LT_0_0 else LE_0_0 in
  TRANS th0 th1);;

(* LE tables *)

(* Generates the theorem |- bi(n) <= _0 <=> F (or |- b0(n) <= _0 <=> n <= _0) *)
let gen_bi_le_0 i =
  let bin = mk_comb (const_array.(i), n_var_num) in
  let lt_tm = mk_binop le_op_num bin zero_num in
    if i > 0 then
      (PURE_REWRITE_RULE[NUMERAL] o prove)(mk_eq(lt_tm, f_const), REWRITE_TAC[def_array.(i)] THEN ARITH_TAC)
    else
      (PURE_REWRITE_RULE[NUMERAL] o prove)(mk_eq(lt_tm, `n <= 0`), REWRITE_TAC[B0_EXPLICIT] THEN ARITH_TAC);;

let th_le0_array = Array.init maximum gen_bi_le_0;;
let th_le0_0_array = Array.init maximum (fun i ->
  if i = 0 then
    TRANS (INST[zero_const, n_var_num] th_le0_array.(0)) LE_0_0
  else
    INST[zero_const, n_var_num] th_le0_array.(i));;


(* Generates the theorem |- bi(m) <= bj(n) <=> m <= n (or m < n) *)
let gen_bi_le_bj i j =
  let bim = mk_comb (const_array.(i), m_var_num) in
  let bjn = mk_comb (const_array.(j), n_var_num) in
  let lt_tm = mk_binop le_op_num bim bjn in
  let rhs = 
    if i > j then
      mk_binop lt_op_num m_var_num n_var_num 
    else
      mk_binop le_op_num m_var_num n_var_num in
    prove(mk_eq(lt_tm, rhs), REWRITE_TAC[def_array.(i); def_array.(j)] THEN ARITH_TAC);;

(* Given the theorem |- bi(m) <= bj(n) <=> P m n, generates the theorem
   |- SUC(bi(m)) <= SUC(bj(n)) <=> P m n *)
let gen_next_le_thm th =
  let ltm, n_tm = (dest_comb o lhand o concl) th in
  let m_tm = rand ltm in
  let th0 = INST[m_tm, m_var_num; n_tm, n_var_num] SUC_LE_THM in
  let suc_m = raw_suc_arg m_tm in
  let suc_n = raw_suc_arg n_tm in
  let th1 = SYM (MK_COMB ((AP_TERM le_op_num suc_m), suc_n)) in
    TRANS (TRANS th1 th0) th;;
  
let th_le_array = Array.make (maximum * maximum) (REFL zero_const);;

for i = 0 to maximum - 1 do
  let th = ref (gen_bi_le_bj 0 i) in
  let _ = th_le_array.(i) <- !th in

    for k = 1 to maximum - i - 1 do
      let x = k and y = i + k in
      th := gen_next_le_thm (!th);
      th_le_array.(x * maximum + y) <- !th
    done;
done;;

for i = 1 to maximum - 1 do
  let th = ref (gen_bi_le_bj i 0) in
  let _ = th_le_array.(i * maximum) <- !th in

    for k = 1 to maximum - i - 1 do
      let x = i + k and y = k in
      th := gen_next_le_thm (!th);
      th_le_array.(x * maximum + y) <- !th
    done;
done;;

let th_le_00_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  let th0 = INST[zero_const, m_var_num; zero_const, n_var_num] th_le_array.(idx) in
  let th1 = if i > j then LT_0_0 else LE_0_0 in
  TRANS th0 th1);;

(* Conversions *)

let rec raw_lt_args ltm rtm =
  if is_const rtm then
    (* n < _0 <=> F *)
    INST[ltm, n_var_num] LT_n_0
  else if is_const ltm then
    (* _0 < Bi(n) *)
    let bn_tm, n_tm = dest_comb rtm in
    let j = digit_id bn_tm in
    if n_tm = zero_const then
      th_lt0_0_array.(j)
    else if j = 0 then
      let th0 = INST[n_tm, n_var_num] th_lt0_array.(0) in
      let th1 = raw_lt_args zero_const n_tm in
      TRANS th0 th1
    else
      INST[n_tm, n_var_num] th_lt0_array.(j)
  else
    (* Bi(m) < Bj(n) *)
    let bm_tm, m_tm = dest_comb ltm in
    let bn_tm, n_tm = dest_comb rtm in
    let i = digit_id bm_tm in
    let j = digit_id bn_tm in
    let idx = i * maximum + j in
    if m_tm = zero_const && n_tm = zero_const then
      th_lt_00_array.(idx)
    else
      let th0 = INST[m_tm, m_var_num; n_tm, n_var_num] th_lt_array.(idx) in
      let th1 =
        if i >= j then
          raw_lt_args m_tm n_tm
        else
          raw_le_args m_tm n_tm in
      TRANS th0 th1

and raw_le_args ltm rtm =
  if is_const ltm then
    (* _0 <= n <=> T *)
    INST[rtm, n_var_num] LE_0_n
  else if is_const rtm then
    (* Bi(n) <= _0 *)
    let bm_tm, m_tm = dest_comb ltm in
    let i = digit_id bm_tm in
    if m_tm = zero_const then
      th_le0_0_array.(i)
    else if i = 0 then
      let th0 = INST[m_tm, n_var_num] th_le0_array.(0) in
      let th1 = raw_le_args m_tm zero_const in
      TRANS th0 th1
    else
      INST[m_tm, n_var_num] th_le0_array.(i)
  else
    (* Bi(m) <= Bj(n) *)
    let bm_tm, m_tm = dest_comb ltm in
    let bn_tm, n_tm = dest_comb rtm in
    let i = digit_id bm_tm in
    let j = digit_id bn_tm in
    let idx = i * maximum + j in
    if m_tm = zero_const && n_tm = zero_const then
      th_le_00_array.(idx)
    else
      let th0 = INST[m_tm, m_var_num; n_tm, n_var_num] th_le_array.(idx) in
      let th1 =
        if i > j then
          raw_lt_args m_tm n_tm
        else
          raw_le_args m_tm n_tm in
      TRANS th0 th1;;

let nlt ltm rtm =
  if ltm = rtm then
    INST[ltm, n_var_num] LT_REFL_F
  else
    raw_lt_args ltm rtm;;

let nle ltm rtm =
  if ltm = rtm then
    INST[ltm, n_var_num] LE_REFL_T
  else
    raw_le_args ltm rtm;;

(**************************************)
(* ADD_CONV *)

(* ADD theorems *)

let CADD_0_n = prove(`SUC (_0 + n) = SUC n`, REWRITE_TAC[ADD_0_n]);;
let CADD_n_0 = prove(`SUC (n + _0) = SUC n`, REWRITE_TAC[ADD_n_0]);;

(* B0 (SUC n) = B0 n + maximum *)
let B0_SUC = prove(mk_eq(mk_comb(b0_const, mk_comb(suc_op_num, n_var_num)),
                         mk_binop add_op_num max_const (mk_comb(b0_const, n_var_num))),
                   REWRITE_TAC [B0_EXPLICIT] THEN ARITH_TAC);;

let B0_ADD = prove(mk_eq(mk_binop add_op_num (mk_comb(b0_const, m_var_num)) (mk_comb(b0_const, n_var_num)),
                         mk_comb(b0_const, mk_binop add_op_num m_var_num n_var_num)),
                   REWRITE_TAC[B0_EXPLICIT] THEN ARITH_TAC);;

let SUC_ADD_RIGHT = prove(`SUC(m + n) = m + SUC n`, ARITH_TAC);;


(* Generate all theorems iteratively *)
let th_add_right_next th =
  let lhs, rhs = dest_eq(concl th) in
  let ltm, rtm = dest_comb rhs in
  let i = digit_id ltm in
  let suc_th = AP_TERM suc_op_num th in
  let th_rhs = INST[rtm, n_var_num] th_suc_array.(i) in
  let ltm, rarg = dest_comb lhs in
  let larg = rand ltm in
  let th1 = INST[larg, m_var_num; rarg, n_var_num] SUC_ADD_RIGHT in
  let j = digit_id (rator rarg) in
  let th2 = th_suc_array.(j) in
  let th_lhs = TRANS th1 (AP_TERM ltm th2) in
    TRANS (TRANS (SYM th_lhs) suc_th) th_rhs;;

let th_add_array = Array.make (maximum * maximum) (REFL zero_const);;

for i = 0 to maximum - 1 do
  let th0 =
    if i = 0 then
      B0_ADD
    else
      INST[n_var_num, m_var_num; m_var_num, n_var_num]
        (ONCE_REWRITE_RULE[ADD_AC] th_add_array.(i)) in
  let _ = th_add_array.(i * maximum) <- th0 in

    for j = 1 to maximum - 1 do
      th_add_array.(i * maximum + j) <- th_add_right_next th_add_array.(i * maximum + j - 1)
    done;
done;;

(* SUC (B_i(m) + B_j(n)) = B_p(...) *)
let th_cadd i j =
  let add_th = th_add_array.(i * maximum + j) in
  let th0 = AP_TERM suc_op_num add_th in
  let ltm, rtm = dest_comb(rand(concl th0)) in
  let ltm, rtm = dest_comb rtm in
  let k = digit_id ltm in
  let suc_th = INST[rtm, n_var_num] th_suc_array.(k) in
    TRANS th0 suc_th;;

let th_cadd_array = Array.make (maximum * maximum) (REFL zero_const);;

for i = 0 to maximum - 1 do
  for j = 0 to maximum - 1 do
    th_cadd_array.(i * maximum + j) <- th_cadd i j
  done;
done;;

let add_bit_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  const_array.(if i + j >= maximum then i + j - maximum else i + j));;

let cadd_bit_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  const_array.(if i + j + 1 >= maximum then i + j + 1 - maximum else i + j + 1));;

let ADD_m_0 = INST [m_var_num, n_var_num] ADD_n_0;;
let CADD_m_0 = INST [m_var_num, n_var_num] CADD_n_0;;

let th_add_0n_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  let th0 = INST [zero_const, m_var_num] th_add_array.(idx) in
  let bit = add_bit_array.(idx) in
  if i + j >= maximum then
    TRANS th0 (AP_TERM bit CADD_0_n)
  else
    TRANS th0 (AP_TERM bit ADD_0_n));;

let th_add_m0_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  let th0 = INST [zero_const, n_var_num] th_add_array.(idx) in
  let bit = add_bit_array.(idx) in
  if i + j >= maximum then
    TRANS th0 (AP_TERM bit CADD_m_0)
  else
    TRANS th0 (AP_TERM bit ADD_m_0));;

let th_add_00_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  let th0 = INST [zero_const, n_var_num] th_add_0n_array.(idx) in
  let bit = add_bit_array.(idx) in
  if i + j >= maximum then
    TRANS th0 (AP_TERM bit SUC_0)
  else
    th0);;

let th_cadd_0n_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  let th0 = INST [zero_const, m_var_num] th_cadd_array.(idx) in
  let bit = cadd_bit_array.(idx) in
  if i + j + 1 >= maximum then
    TRANS th0 (AP_TERM bit CADD_0_n)
  else
    TRANS th0 (AP_TERM bit ADD_0_n));;

let th_cadd_m0_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  let th0 = INST [zero_const, n_var_num] th_cadd_array.(idx) in
  let bit = cadd_bit_array.(idx) in
  if i + j + 1 >= maximum then
    TRANS th0 (AP_TERM bit CADD_m_0)
  else
    TRANS th0 (AP_TERM bit ADD_m_0));;

let th_cadd_00_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  let th0 = INST [zero_const, n_var_num] th_cadd_0n_array.(idx) in
  let bit = cadd_bit_array.(idx) in
  if i + j + 1 >= maximum then
    TRANS th0 (AP_TERM bit SUC_0)
  else
    th0);;

(* ADD conversion *)
let rec raw_add_args ltm rtm =
  if ltm = zero_const then
    INST [rtm, n_var_num] ADD_0_n
  else if rtm = zero_const then
    INST [ltm, n_var_num] ADD_n_0
  else
    let lbit, larg = dest_comb ltm
    and rbit, rarg = dest_comb rtm in
    let i = digit_id lbit
    and j = digit_id rbit in
    let idx = i * maximum + j in
    let cflag = (i + j >= maximum) in
    if larg = zero_const then
      if rarg = zero_const then
        th_add_00_array.(idx)
      else
        let th = INST [rarg, n_var_num] th_add_0n_array.(idx) in
        if cflag then
          TRANS th (AP_TERM add_bit_array.(idx) (raw_suc_arg rarg))
        else
          th
    else if rarg = zero_const then
      let th = INST [larg, m_var_num] th_add_m0_array.(idx) in
      if cflag then
        TRANS th (AP_TERM add_bit_array.(idx) (raw_suc_arg larg))
      else
        th
    else
      let th = INST [larg, m_var_num; rarg, n_var_num] th_add_array.(idx) in
      let r_th =
        if cflag then raw_adc_args larg rarg
        else raw_add_args larg rarg in
      TRANS th (AP_TERM add_bit_array.(idx) r_th)

and raw_adc_args ltm rtm =
  if ltm = zero_const then
    let th = INST [rtm, n_var_num] CADD_0_n in
    TRANS th (raw_suc_arg rtm)
  else if rtm = zero_const then
    let th = INST [ltm, n_var_num] CADD_n_0 in
    TRANS th (raw_suc_arg ltm)
  else
    let lbit, larg = dest_comb ltm
    and rbit, rarg = dest_comb rtm in
    let i = digit_id lbit
    and j = digit_id rbit in
    let idx = i * maximum + j in
    let cflag = (i + j + 1 >= maximum) in
    if larg = zero_const then
      if rarg = zero_const then
        th_cadd_00_array.(idx)
      else
        let th = INST [rarg, n_var_num] th_cadd_0n_array.(idx) in
        if cflag then
          TRANS th (AP_TERM cadd_bit_array.(idx) (raw_suc_arg rarg))
        else
          th
    else if rarg = zero_const then
      let th = INST [larg, m_var_num] th_cadd_m0_array.(idx) in
      if cflag then
        TRANS th (AP_TERM cadd_bit_array.(idx) (raw_suc_arg larg))
      else
        th
    else
      let th = INST [larg, m_var_num; rarg, n_var_num] th_cadd_array.(idx) in
      let r_th =
        if cflag then raw_adc_args larg rarg
        else raw_add_args larg rarg in
      TRANS th (AP_TERM cadd_bit_array.(idx) r_th);;

let nadd = raw_add_args;;
  
(********************************)
(* Subtraction *)

let SUB_lemma1 = (UNDISCH_ALL o ARITH_RULE) `n + t = m ==> m - n = t:num`;;
let SUB_lemma2 = (UNDISCH_ALL o REWRITE_RULE[NUMERAL] o ARITH_RULE) `m + t = n ==> m - n = 0`;;
let LE_lemma = (UNDISCH_ALL o ARITH_RULE) `n + t = m ==> n <= m:num`;;

let SUB_0_n = (PURE_REWRITE_RULE[NUMERAL] o prove)(`0 - n = 0`, ARITH_TAC);;
let SUB_n_0 = (PURE_REWRITE_RULE[NUMERAL] o prove)(`n - 0 = n`, ARITH_TAC);;
let SUB_REFL = (PURE_REWRITE_RULE[NUMERAL] o prove)(`n - n = 0`, ARITH_TAC);;
let LE_n_n = prove(`n:num <= n`, ARITH_TAC);;
let LE_0_n' = (PURE_REWRITE_RULE[NUMERAL] o prove)(`0 <= n`, ARITH_TAC);;

let raw_sub_args m_tm n_tm =
  if m_tm = zero_const then
    INST [n_tm, n_var_num] SUB_0_n
  else if n_tm = zero_const then
    INST [m_tm, n_var_num] SUB_n_0
  else if m_tm = n_tm then
    INST [m_tm, n_var_num] SUB_REFL
  else
    let m = dest_nat m_tm in
    let n = dest_nat n_tm in
    let t = m -/ n in
    if t >=/ num_0 then
      let t_tm = mk_nat t in
      let th0 = INST[n_tm, n_var_num; t_tm, t_var_num; m_tm, m_var_num] SUB_lemma1 in
      let th_add = raw_add_args n_tm t_tm in
      MY_PROVE_HYP th_add th0
    else
      let t_tm = mk_nat (n -/ m) in
      let th0 = INST[m_tm, m_var_num; t_tm, t_var_num; n_tm, n_var_num] SUB_lemma2 in
      let th_add = raw_add_args m_tm t_tm in
      MY_PROVE_HYP th_add th0;;

let nsub = raw_sub_args;;
  
(* Returns either (tm1 - tm2, tm2 <= tm1) or (tm2 - tm1, tm1 <= tm2) *)
let nsub_le tm1 tm2 =
  if tm1 = tm2 then
    (INST[tm1, n_var_num] SUB_REFL, INST[tm1, n_var_num] LE_n_n, true)
  else if tm2 = zero_const then
    (INST[tm1, n_var_num] SUB_n_0, INST[tm1, n_var_num] LE_0_n', true)
  else if tm1 = zero_const then
    (INST[tm2, n_var_num] SUB_n_0, INST[tm2, n_var_num] LE_0_n', false)
  else
    let m = dest_nat tm1 in
    let n = dest_nat tm2 in
    let t = m -/ n in
    if t >=/ num_0 then
      let t_tm = mk_nat t in
      let inst = INST[tm2, n_var_num; t_tm, t_var_num; tm1, m_var_num] in
      let th_sub = inst SUB_lemma1 in
      let th_le = inst LE_lemma in
      let th_add = raw_add_args tm2 t_tm in
      (MY_PROVE_HYP th_add th_sub, MY_PROVE_HYP th_add th_le, true)
    else
      let t_tm = mk_nat (n -/ m) in
      let inst = INST[tm2, m_var_num; t_tm, t_var_num; tm1, n_var_num] in
      let th_sub = inst SUB_lemma1 in
      let th_le = inst LE_lemma in
      let th_add = raw_add_args tm1 t_tm in
      (MY_PROVE_HYP th_add th_sub, MY_PROVE_HYP th_add th_le, false);;

(********************************)
(* Multiplication *)

let MUL_0_n = prove(`_0 * n = _0`, ONCE_REWRITE_TAC[MULT_SYM] THEN REWRITE_TAC[MUL_n_0; NUMERAL]);;

let MUL_n_0 = ONCE_REWRITE_RULE[MULT_AC] MUL_0_n;;

let MUL_1_n, MUL_n_1 =
  let one_const = dj0_array.(1) in
  let cond = mk_eq(mk_binop mul_op_num one_const n_var_num, n_var_num) in
  let th = (REWRITE_RULE[NUMERAL] o prove)(cond, PURE_ONCE_REWRITE_TAC[GSYM ZERO_EQ_ZERO]
   THEN REWRITE_TAC[def_array.(1)] THEN ARITH_TAC) in
    th, ONCE_REWRITE_RULE[MULT_AC] th;;

let MUL_B0_t = prove(mk_eq(mk_binop mul_op_num (mk_comb(b0_const, n_var_num)) t_var_num,
                           mk_comb(b0_const, mk_binop mul_op_num n_var_num t_var_num)),
                     REWRITE_TAC[def_array.(0)] THEN ARITH_TAC);;

let MUL_t_B0 = ONCE_REWRITE_RULE[MULT_AC] MUL_B0_t;;

let MUL_SUC_RIGHT = prove(`m * SUC(n) = m * n + m`, ARITH_TAC);;

let MUL_SYM = prove(mk_eq(mk_binop mul_op_num m_var_num n_var_num,
                          mk_binop mul_op_num n_var_num m_var_num),
                    REWRITE_TAC[MULT_AC]);;

(* Multiplication table *)
let mul_th_next_right th =
  let ltm, rtm = dest_comb(rand(rator(concl th))) in
  let mtm = rand ltm in
  let th0 = INST[mtm, m_var_num; rtm, n_var_num] MUL_SUC_RIGHT in
  let th1 = AP_THM (AP_TERM add_op_num th) mtm in
  let sum_th = raw_add_args (rand(concl th)) mtm in
  let th2 = TRANS (TRANS th0 th1) sum_th in
  let j = digit_id (rator rtm) in
  let th_suc = th_suc_0_array.(j) in
  let th3 = AP_TERM (mk_comb (mul_op_num, mtm)) th_suc in
    TRANS (SYM th3) th2;;

let mul_array = Array.make (maximum * maximum) (REFL zero_const);;
for i = 1 to maximum - 1 do
  let th1 = INST[dj0_array.(i), n_var_num] MUL_n_1 in
  let _ = mul_array.(i * maximum + 1) <- th1 in

    for j = 2 to maximum - 1 do
      mul_array.(i * maximum + j) <- mul_th_next_right mul_array.(i * maximum + j - 1)
    done;
done;;

(* Single-digit right multiplication theorem:
   B_i(m) * B_j(0) = B_p(B_q(0) + m * B_j(0))  (if i * j >= maximum)
   B_i(m) * B_j(0) = B_p(m * B_j(0))           (if i * j < maximum) *)
let prod1_lemma =
  let mul (a, b) = mk_binop mul_op_num a b and
      add (a, b) = mk_binop add_op_num a b in
  let lhs = mul(add(t_var_num, mk_comb(b0_const, m_var_num)), r_var_num) in
  let rhs = add(mul(t_var_num, r_var_num),
                mk_comb(b0_const, mul(m_var_num, r_var_num))) in
    prove(mk_eq(lhs, rhs),
          REWRITE_TAC[RIGHT_ADD_DISTRIB; MUL_B0_t]);;

let mul1_right_th i j =
  let bi0 = dj0_array.(i) and
      bj0 = dj0_array.(j) in
  let def_i = INST[m_var_num, n_var_num] def_thm_array.(i) in
  let th0 = AP_THM (AP_TERM mul_op_num def_i) bj0 in
  let th1 = TRANS th0 (INST[bi0, t_var_num; bj0, r_var_num] prod1_lemma) in
  let mul_th = mul_array.(i * maximum + j) in
  let m_bj0 = mk_binop mul_op_num m_var_num bj0 in
  let rarg = mk_comb(b0_const, m_bj0) in
  let th2 = TRANS th1 (AP_THM (AP_TERM add_op_num mul_th) rarg) in
  let p = (i * j) mod maximum in
  if i * j < maximum then
    let th_add = INST[m_bj0, n_var_num] th_add_0n_array.(p * maximum) in
    TRANS th2 th_add
  else
    let q = (i * j) / maximum in
    let th_add = INST[dj0_array.(q), m_var_num; m_bj0, n_var_num] th_add_array.(p * maximum) in
    TRANS th2 th_add;;

let mul1_right_th_array = Array.make (maximum * maximum) (REFL zero_const);;
for i = 1 to maximum - 1 do
  for j = 1 to maximum - 1 do
    mul1_right_th_array.(i * maximum + j) <- mul1_right_th i j
  done;
done;;

let mul1_bit_low_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  const_array.((i * j) mod maximum));;

let mul1_bit_high_array = Array.init (maximum * maximum) (fun idx ->
  let i = idx / maximum and j = idx mod maximum in
  dj0_array.((i * j) / maximum));;

let mul1_plus_high_array = Array.init (maximum * maximum) (fun idx ->
  mk_comb(add_op_num, mul1_bit_high_array.(idx)));;

let mul_b0_right_array = Array.init maximum (fun j ->
  INST [dj0_array.(j), t_var_num] MUL_B0_t);;

(* Row-by-row multiplication step theorem:
   |- m * D_j(n) = D_0(m * n) + m * D_j(_0) *)
let MUL_STEP_GEN = prove(
  mk_eq(mk_binop mul_op_num m_var_num (mk_binop add_op_num t_var_num (mk_comb(b0_const, n_var_num))),
        mk_binop add_op_num (mk_comb(b0_const, mk_binop mul_op_num m_var_num n_var_num))
                            (mk_binop mul_op_num m_var_num t_var_num)),
  REWRITE_TAC[LEFT_ADD_DISTRIB; MUL_t_B0; ADD_AC]);;

let mul_step_array = Array.init maximum (fun j ->
  if j = 0 then REFL zero_const
  else
    let th0 = AP_TERM (mk_comb(mul_op_num, m_var_num)) def_thm_array.(j) in
    TRANS th0 (INST[dj0_array.(j), t_var_num] MUL_STEP_GEN));;


(******************************************************)
(* Conversions *)

(* Multiplies arg and D_j(_0) *)
let rec raw_mul1_right j arg =
  if arg = zero_const then
    INST [dj0_array.(j), n_var_num] MUL_0_n
  else if j = 1 then
    INST [arg, n_var_num] MUL_n_1
  else
    let btm, mtm = dest_comb arg in
    let i = digit_id btm in
    if (i = 0) then
      let th = INST[mtm, n_var_num] mul_b0_right_array.(j) in
      TRANS th (AP_TERM b0_const (raw_mul1_right j mtm))
    else
      let idx = i * maximum + j in
      if (mtm = zero_const) then
        mul_array.(idx)
      else
        let th = INST[mtm, m_var_num] mul1_right_th_array.(idx) in
        let th_rec = raw_mul1_right j mtm in
        let bit_p = mul1_bit_low_array.(idx) in
        if (i * j >= maximum) then
          let th2 = AP_TERM mul1_plus_high_array.(idx) th_rec in
          let th_add = raw_add_args mul1_bit_high_array.(idx) (rand(concl th_rec)) in
          TRANS th (AP_TERM bit_p (TRANS th2 th_add))
        else
          TRANS th (AP_TERM bit_p th_rec);;

(* Computes larg * rarg *)
let rec raw_mul_args larg rarg =
  if larg = zero_const then
    INST [rarg, n_var_num] MUL_0_n
  else if rarg = zero_const then
    INST [larg, n_var_num] MUL_n_0
  else
    let lbtm, mtm = dest_comb larg in
    let i = digit_id lbtm in
    if (i = 0) then
      let th = INST[rarg, t_var_num; mtm, n_var_num] MUL_B0_t in
      TRANS th (AP_TERM b0_const (raw_mul_args mtm rarg))
    else
      let rbtm, ntm = dest_comb rarg in
      let j = digit_id rbtm in
      if (j = 0) then
        let th = INST[larg, t_var_num; ntm, n_var_num] MUL_t_B0 in
        TRANS th (AP_TERM b0_const (raw_mul_args larg ntm))
      else if (ntm = zero_const) then
        if (mtm = zero_const) then
          mul_array.(i * maximum + j)
        else
          raw_mul1_right j larg
      else if (mtm = zero_const) then
        if (i = 1) then
          INST [rarg, n_var_num] MUL_1_n
        else
          let th_comm = INST[larg, m_var_num; rarg, n_var_num] MUL_SYM in
          TRANS th_comm (raw_mul1_right i rarg)
      else
        let th0 = INST[larg, m_var_num; ntm, n_var_num] mul_step_array.(j) in
        let th_mul0 = raw_mul_args larg ntm in
        let th_b0_mul0 = AP_TERM b0_const th_mul0 in
        let th_mul1 = raw_mul1_right j larg in
        let add_th = MK_COMB (AP_TERM add_op_num th_b0_mul0, th_mul1) in
        let add = TRANS add_th (raw_add_args (rand(concl th_b0_mul0)) (rand(concl th_mul1))) in
          TRANS th0 add;;

let nmul = raw_mul_args;;

(************************************)
(* DIV *)

let DIV_UNIQ' = (UNDISCH_ALL o 
       PURE_ONCE_REWRITE_RULE[ARITH_RULE `a < b <=> (a < b:num <=> T)`] o 
       ONCE_REWRITE_RULE[ARITH_RULE `m = q * n + r <=> q * n + r = m:num`] o
       REWRITE_RULE[GSYM IMP_IMP] o SPEC_ALL) DIV_UNIQ;;

let DIV_LT_THM =
  let th0 = INST[zero_const, q_var_num; m_var_num, r_var_num] DIV_UNIQ' in
  let hyp1 = TRANS (AP_THM (AP_TERM add_op_num MUL_0_n) m_var_num) (INST[m_var_num, n_var_num] ADD_0_n) in
  MY_PROVE_HYP hyp1 th0;;

let DIV_EXACT_THM =
  let th0 = INST[zero_const, r_var_num] DIV_UNIQ' in
  let qn_tm = mk_binop mul_op_num q_var_num n_var_num in
  let eq_th = ASSUME (mk_eq(qn_tm, m_var_num)) in
  let hyp1 = TRANS (INST[qn_tm, n_var_num] ADD_n_0) eq_th in
  MY_PROVE_HYP hyp1 th0;;

(* Computes m DIV n *)
let raw_div_args m_tm n_tm =
  let m = dest_nat m_tm in
  let n = dest_nat n_tm in
  if m </ n then
    let th_lt = raw_lt_args m_tm n_tm in
    let th0 = INST[m_tm, m_var_num; n_tm, n_var_num] DIV_LT_THM in
    MY_PROVE_HYP th_lt th0
  else
    let q = Num.quo_num m n in
    let r = m -/ (q */ n) in
    let q_tm = mk_nat q in
    let qn_th = raw_mul_args q_tm n_tm in
    if r =/ num_0 then
      let th_gt0, _ = raw_gt0_hash_conv n_tm in
      let th0 = INST[n_tm, n_var_num; m_tm, m_var_num; q_tm, q_var_num] DIV_EXACT_THM in
      MY_PROVE_HYP qn_th (MY_PROVE_HYP th_gt0 th0)
    else
      let r_tm = mk_nat r in
      let qn_tm = rand (concl qn_th) in
      let qnr_th = raw_add_args qn_tm r_tm in
      let th1 = TRANS (AP_THM (AP_TERM add_op_num qn_th) r_tm) qnr_th in
      let th2 = raw_lt_args r_tm n_tm in
      let th0 = INST[r_tm, r_var_num; n_tm, n_var_num; m_tm, m_var_num; q_tm, q_var_num] DIV_UNIQ' in
      MY_PROVE_HYP th1 (MY_PROVE_HYP th2 th0);;

let ndiv = raw_div_args;;

(*********************************************)
(* EVEN_CONV, ODD_CONV *)

let even_const = `EVEN` and
    odd_const = `ODD` and
    eq_const = `<=>`;;

let EVEN_ZERO = prove(`EVEN _0 <=> T`, REWRITE_TAC[ARITH_EVEN]);;
let ODD_ZERO = prove(`ODD _0 <=> F`, REWRITE_TAC[ARITH_ODD]);;


let EVEN_B0 = prove(mk_eq(mk_comb(`EVEN`, mk_comb(b0_const, `n:num`)), `T`),
        REWRITE_TAC[B0_EXPLICIT; EVEN_MULT] THEN
          DISJ1_TAC THEN CONV_TAC NUM_EVEN_CONV);;


let ODD_B0 = prove(mk_eq(mk_comb(`ODD`, mk_comb(b0_const, `n:num`)), `F`),
       REWRITE_TAC[NOT_ODD; EVEN_B0]);;
       
let EVEN_SUC_T = prove(`(EVEN (SUC n) <=> T) <=> (EVEN n <=> F)`, REWRITE_TAC[EVEN]);;
let EVEN_SUC_F = prove(`(EVEN (SUC n) <=> F) <=> (EVEN n <=> T)`, REWRITE_TAC[EVEN]);;

let ODD_SUC_T = prove(`(ODD (SUC n) <=> T) <=> (ODD n <=> F)`, REWRITE_TAC[ODD]);;
let ODD_SUC_F = prove(`(ODD (SUC n) <=> F) <=> (ODD n <=> T)`, REWRITE_TAC[ODD]);;

let next_even_th th =
  let ltm, rtm = dest_comb(concl th) in
  let b_tm = rand(rand ltm) in
  let suc_b = raw_suc_arg b_tm in
  let flag = (fst o dest_const) rtm = "T" in
  let th0 = SYM (AP_TERM even_const suc_b) in
  let th1 = AP_THM (AP_TERM eq_const th0) (if flag then f_const else t_const) in
  let th2 = INST[b_tm, n_var_num] (if flag then EVEN_SUC_F else EVEN_SUC_T) in
    EQ_MP (SYM (TRANS th1 th2)) th;;

let next_odd_th th =
  let ltm, rtm = dest_comb(concl th) in
  let b_tm = rand(rand ltm) in
  let suc_b = raw_suc_arg b_tm in
  let flag = (fst o dest_const) rtm = "T" in
  let th0 = SYM (AP_TERM odd_const suc_b) in
  let th1 = AP_THM (AP_TERM eq_const th0) (if flag then f_const else t_const) in
  let th2 = INST[b_tm, n_var_num] (if flag then ODD_SUC_F else ODD_SUC_T) in
    EQ_MP (SYM (TRANS th1 th2)) th;;

let even_thm_array = Array.make maximum EVEN_B0;;
for i = 1 to maximum - 1 do
  even_thm_array.(i) <- next_even_th even_thm_array.(i - 1)
done;;

let odd_thm_array = Array.make maximum ODD_B0;;
for i = 1 to maximum - 1 do
  odd_thm_array.(i) <- next_odd_th odd_thm_array.(i - 1)
done;;

let even_thm_0_array = Array.init maximum (fun i ->
  INST[zero_const, n_var_num] even_thm_array.(i));;

let odd_thm_0_array = Array.init maximum (fun i ->
  INST[zero_const, n_var_num] odd_thm_array.(i));;

let neven tm =
  if is_const tm then
    EVEN_ZERO
  else
    let b_tm, n_tm = dest_comb tm in
    let i = digit_id b_tm in
    if n_tm = zero_const then
      even_thm_0_array.(i)
    else
      INST[n_tm, n_var_num] even_thm_array.(i);;

let nodd tm =
  if is_const tm then
    ODD_ZERO
  else
    let b_tm, n_tm = dest_comb tm in
    let i = digit_id b_tm in
    if n_tm = zero_const then
      odd_thm_0_array.(i)
    else
      INST[n_tm, n_var_num] odd_thm_array.(i);;


end;;
