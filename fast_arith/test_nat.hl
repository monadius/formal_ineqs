(* ========================================================================== *)
(*      Formal verification of nonlinear inequalities in HOL Light            *)
(*                                                                            *)
(*      Performance benchmarks and verification tests for arith_num2.hl       *)
(* ========================================================================== *)

(* Load dependencies and both baseline and optimized modules *)
needs "misc/misc_functions.hl";;
needs "misc/misc_vars.hl";;
needs "arith_options.hl";;

Arith_options.base := 100;;

needs "fast_arith/nat_arith.hl";;
needs "fast_arith/arith_num3.hl";;

module type Arith_num_sig =
  sig
    val mk_nat : num -> term
    val mk_small_nat : int -> term
    val dest_nat : term -> num

    val nsuc : term -> thm
    val npre : term -> thm

    val neven : term -> thm * bool
    val nodd : term -> thm * bool
    val neq0 : term -> thm * bool
    val ngt0 : term -> thm * bool
    val neq : term -> term -> thm * bool
    val nlt : term -> term -> thm * bool
    val nle : term -> term -> thm * bool

    (* val nmax : term -> term -> thm
    val nmin : term -> term -> thm *)

    val nadd : term -> term -> thm
    val nsub : term -> term -> thm
    val nsub_le : term -> term -> thm * thm * bool
    val nmul : term -> term -> thm
    val ndiv : term -> term -> thm

  end;;

open Misc_vars;;

(****************************************************************************)
(* Timing and benchmarking harness                                          *)
(****************************************************************************)

type arith_module = (module Arith_num_sig);;

type test_result = {
  name : string;
  samples : int;
  baseline_time : float; (* in seconds *)
  optimized_time : float; (* in seconds *)
  speedup : float;
  passed : bool;
};;

let time_batch iterations f args =
  let n = Array.length args in
  let res = Array.make n (f args.(0)) in
  let start = Unix.gettimeofday() in
  for iter = 1 to iterations do
    for i = 0 to n - 1 do
      res.(i) <- f args.(i)
    done
  done;
  let finish = Unix.gettimeofday() in
  res, (finish -. start) /. (float_of_int iterations);;

(* Helpers to create term inputs for a given Arith_num_sig module *)
let mk_num_term (module Mod_m : Arith_num_sig) n = Mod_m.mk_nat n;;

let verify_eq ((module Mod1 : Arith_num_sig), (module Mod2 : Arith_num_sig)) th1 th2 =
  if hyp th1 <> [] || hyp th2 <> [] then false
  else
    let c1 = concl th1 and c2 = concl th2 in
    let r1 = rand c1 and r2 = rand c2 in
    if r1 = t_const || r1 = f_const then
      r1 = r2
    else
      try
        let v1 = Mod1.dest_nat r1 in
        let v2 = Mod2.dest_nat r2 in
        v1 =/ v2
      with _ ->
        c1 = c2;;

let verify_sub_and_le (((module Mod1 : Arith_num_sig), (module Mod2 : Arith_num_sig)) as mods)
    (th_sub1, th_le1) (th_sub2, th_le2) =
  verify_eq mods th_sub1 th_sub2 &&
  hyp th_le1 = [] && hyp th_le2 = [] &&
  (try
     let l1, r1 = dest_binop le_op_num (concl th_le1) in
     let l2, r2 = dest_binop le_op_num (concl th_le2) in
     let vl1 = Mod1.dest_nat l1 and vr1 = Mod1.dest_nat r1 in
     let vl2 = Mod2.dest_nat l2 and vr2 = Mod2.dest_nat r2 in
     vl1 =/ vl2 && vr1 =/ vr2 && vl2 <=/ vr2
   with _ -> false);;

let bench_compare_with verify name iterations f1 f2 args1 args2 =
  let n = Array.length args1 in
  let res1, t1 = time_batch iterations f1 args1 in
  let res2, t2 = time_batch iterations f2 args2 in
  let speedup = if t2 > 0.0 then t1 /. t2 else 0.0 in
  let passed = ref true in
  for i = 0 to n - 1 do
    if not (verify res1.(i) res2.(i)) then passed := false
  done;
  Printf.printf "%-40s | N: %4d | Base: %8.3f ms | Opt: %8.3f ms | Speedup: %6.2fx | %s\n"
    name n (t1 *. 1000.0) (t2 *. 1000.0) speedup
    (if !passed then "OK" else "FAIL");
  flush stdout;
  { name = name;
    samples = n;
    baseline_time = t1;
    optimized_time = t2;
    speedup = speedup;
    passed = !passed };;

let bench_compare mods name iterations f1 f2 args1 args2 =
  bench_compare_with (verify_eq mods) name iterations f1 f2 args1 args2;;

(****************************************************************************)
(* Deterministic Random Sample Generators                                   *)
(****************************************************************************)

type sample_set = {
  unary_all    : num array;
  unary_small  : num array;
  unary_large  : num array;
  small_ints   : int array;
  bin_ss       : (num * num) array;
  bin_sl       : (num * num) array;
  bin_ls       : (num * num) array;
  bin_ll       : (num * num) array;
  bin_all      : (num * num) array;
};;

(* Generate a random number with exactly [n_digits] digits in [base].
   Mixes uniform random digits with boundary digits (0, 1, base-1) so that
   carries, borrows, and zero-digit shifts are thoroughly exercised. *)
let gen_num_with_base_digits rng base n_digits =
  if n_digits <= 0 then num_0
  else
    let b_num = Num.num_of_int base in
    let pick_digit is_top =
      let r = Random.State.int rng 10 in
      if is_top then
        if r = 0 then 1
        else if r = 1 then base - 1
        else 1 + Random.State.int rng (base - 1)
      else
        if r = 0 then 0
        else if r = 1 then 1
        else if r = 2 then base - 1
        else Random.State.int rng base
    in
    let acc = ref (Num.num_of_int (pick_digit true)) in
    for i = 2 to n_digits do
      let d = pick_digit false in
      acc := (!acc */ b_num) +/ (Num.num_of_int d)
    done;
    !acc;;

(* Small numbers: 0, 1-digit (1 .. base-1), or 2-digit (base .. base^2-1) *)
let gen_small_num rng base =
  let r = Random.State.int rng 20 in
  if r = 0 then num_0
  else if r <= 10 then gen_num_with_base_digits rng base 1
  else gen_num_with_base_digits rng base 2;;

(* Large numbers: 3 to 16 base digits (~6 to 37 decimal digits) *)
let gen_large_num rng base =
  let n_digits = 3 + Random.State.int rng 14 in
  gen_num_with_base_digits rng base n_digits;;

(* Generate all unary and binary sample points from a single seed.
   - Unary samples: n_samples numbers (half small, half large).
   - Binary samples: n_samples pairs split evenly across all 4 combinations:
     (small, small), (small, large), (large, small), (large, large),
     constructed directly from the same small and large sample points. *)
let generate_sample_set seed n_samples =
  let rng = Random.State.make [| seed |] in
  let base = !Arith_options.base in
  let b_num = Num.num_of_int base in
  let q = if n_samples / 4 < 1 then 1 else n_samples / 4 in
  let half = 2 * q in
  let total = 4 * q in

  (* Deterministic edge cases for small numbers *)
  let small_edge = [|
    num_0;
    num_1;
    Num.num_of_int (base - 1);
    b_num;
    b_num +/ num_1;
    (b_num */ b_num) -/ num_1;
  |] in
  let unary_small = Array.init half (fun i ->
    if i < Array.length small_edge then small_edge.(i)
    else gen_small_num rng base
  ) in

  (* Deterministic edge cases for large numbers *)
  let pow_base k =
    let acc = ref num_1 in
    for i = 1 to k do acc := !acc */ b_num done;
    !acc
  in
  let large_edge = [|
    pow_base 2;
    (pow_base 3) -/ num_1;
    pow_base 4;
    (pow_base 6) -/ num_1;
    pow_base 8;
    (pow_base 10) -/ num_1;
  |] in
  let unary_large = Array.init half (fun i ->
    if i < Array.length large_edge then large_edge.(i)
    else gen_large_num rng base
  ) in

  let unary_all = Array.append unary_small unary_large in

  let small_ints = Array.init total (fun i ->
    if i = 0 then 0
    else if i = 1 then 1
    else if i = 2 then base - 1
    else if i = 3 then base
    else if i = 4 then base * base - 1
    else Random.State.int rng (base * base * base)
  ) in

  (* Build the 4 binary combinations from unary_small and unary_large *)
  let bin_ss = Array.init q (fun i ->
    let lhs = unary_small.(i) in
    let rhs =
      if i mod 10 = 0 then lhs (* include equal pairs *)
      else unary_small.(q + ((i * 7 + 3) mod q))
    in
    (lhs, rhs)
  ) in
  let bin_sl = Array.init q (fun i ->
    (unary_small.(q + i), unary_large.(i))
  ) in
  let bin_ls = Array.init q (fun i ->
    (unary_large.(i), unary_small.(i))
  ) in
  let bin_ll = Array.init q (fun i ->
    let lhs = unary_large.(q + i) in
    let rhs =
      if i mod 10 = 0 then lhs (* include equal pairs *)
      else unary_large.((i * 11 + 5) mod q)
    in
    (lhs, rhs)
  ) in
  let bin_all = Array.concat [bin_ss; bin_sl; bin_ls; bin_ll] in
  {
    unary_all = unary_all;
    unary_small = unary_small;
    unary_large = unary_large;
    small_ints = small_ints;
    bin_ss = bin_ss;
    bin_sl = bin_sl;
    bin_ls = bin_ls;
    bin_ll = bin_ll;
    bin_all = bin_all;
  };;

let prep_binop (mod1, mod2) pairs =
  let base_args = Array.map (fun (n1, n2) -> mk_num_term mod1 n1, mk_num_term mod1 n2) pairs in
  let opt_args  = Array.map (fun (n1, n2) -> mk_num_term mod2 n1, mk_num_term mod2 n2) pairs in
  base_args, opt_args;;

let prep_unop (mod1, mod2) nums =
  let base_tms = Array.map (fun n -> mk_num_term mod1 n) nums in
  let opt_tms  = Array.map (fun n -> mk_num_term mod2 n) nums in
  base_tms, opt_tms;;

(****************************************************************************)
(* 1. Addition Benchmarks                                                   *)
(****************************************************************************)

let run_addition_tests (((module Mod1 : Arith_num_sig), (module Mod2 : Arith_num_sig)) as mods)
    samples iterations =
  Printf.printf "\n====================================================================================================\n";
  Printf.printf " ADDITION BENCHMARKS (raw_add_conv_hash, NUM_ADD_HASH_CONV)\n";
  Printf.printf "====================================================================================================\n";
  let groups = [
    ("raw_add (small + small)", samples.bin_ss);
    ("raw_add (small + large)", samples.bin_sl);
    ("raw_add (large + small)", samples.bin_ls);
    ("raw_add (large + large)", samples.bin_ll);
    ("raw_add (all combinations)", samples.bin_all);
  ] in
  let raw_res = List.map (fun (label, pairs) ->
    let tms_base, tms_opt = prep_binop mods pairs in
    bench_compare mods label iterations
      (fun (a, b) -> Mod1.nadd a b) (fun (a, b) -> Mod2.nadd a b)
      tms_base tms_opt
  ) groups in
  raw_res;;

(****************************************************************************)
(* 2. Multiplication Benchmarks                                             *)
(****************************************************************************)

let run_multiplication_tests (((module Mod1 : Arith_num_sig), (module Mod2 : Arith_num_sig)) as mods)
    samples iterations =
  Printf.printf "\n====================================================================================================\n";
  Printf.printf " MULTIPLICATION BENCHMARKS (raw_mul_conv_hash, NUM_MULT_HASH_CONV)\n";
  Printf.printf "====================================================================================================\n";
  let groups = [
    ("raw_mul (small * small)", samples.bin_ss);
    ("raw_mul (small * large)", samples.bin_sl);
    ("raw_mul (large * small)", samples.bin_ls);
    ("raw_mul (large * large)", samples.bin_ll);
    ("raw_mul (all combinations)", samples.bin_all);
  ] in
  let raw_res = List.map (fun (label, pairs) ->
    let tms_base, tms_opt = prep_binop mods pairs in
    bench_compare mods label iterations
      (fun (a, b) -> Mod1.nmul a b) (fun (a, b) -> Mod2.nmul a b)
      tms_base tms_opt
  ) groups in
  raw_res;;

(****************************************************************************)
(* 3. Subtraction Benchmarks                                                *)
(****************************************************************************)

let run_subtraction_tests (((module Mod1 : Arith_num_sig), (module Mod2 : Arith_num_sig)) as mods)
    samples iterations =
  Printf.printf "\n====================================================================================================\n";
  Printf.printf " SUBTRACTION BENCHMARKS (raw_sub_hash_conv, raw_sub_and_le_hash_conv, NUM_SUB_HASH_CONV)\n";
  Printf.printf "====================================================================================================\n";
  let groups = [
    ("raw_sub (small - small)", samples.bin_ss);
    ("raw_sub (small - large)", samples.bin_sl);
    ("raw_sub (large - small)", samples.bin_ls);
    ("raw_sub (large - large)", samples.bin_ll);
    ("raw_sub (all combinations)", samples.bin_all);
  ] in
  let raw_res = List.map (fun (label, pairs) ->
    let tms_base, tms_opt = prep_binop mods pairs in
    bench_compare mods label iterations
      (fun (a, b) -> Mod1.nsub a b) (fun (a, b) -> Mod2.nsub a b)
      tms_base tms_opt
  ) groups in
  let tms_base, tms_opt = prep_binop mods samples.bin_all in
  let sub_le_res = bench_compare_with (verify_sub_and_le mods)
    "raw_sub_and_le_hash_conv (all)" iterations
    (fun (t1, t2) -> let a, b, _ = Mod1.nsub_le t1 t2 in a, b)
    (fun (t1, t2) -> let a, b, _ = Mod2.nsub_le t1 t2 in a, b)
    tms_base tms_opt in
  raw_res @ [sub_le_res];;

(****************************************************************************)
(* 4. Division Benchmarks                                                   *)
(****************************************************************************)

(* Ensure divisor is non-zero while preserving sample points *)
let non_zero_rhs pairs =
  Array.map (fun (n1, n2) -> if n2 =/ num_0 then (n1, num_1) else (n1, n2)) pairs;;

let run_division_tests (((module Mod1 : Arith_num_sig), (module Mod2 : Arith_num_sig)) as mods)
    samples iterations =
  Printf.printf "\n====================================================================================================\n";
  Printf.printf " DIVISION BENCHMARKS (raw_div_hash_conv, NUM_DIV_HASH_CONV)\n";
  Printf.printf "====================================================================================================\n";
  let groups = [
    ("raw_div (small DIV small)", non_zero_rhs samples.bin_ss);
    ("raw_div (small DIV large)", non_zero_rhs samples.bin_sl);
    ("raw_div (large DIV small)", non_zero_rhs samples.bin_ls);
    ("raw_div (large DIV large)", non_zero_rhs samples.bin_ll);
    ("raw_div (all combinations)", non_zero_rhs samples.bin_all);
  ] in
  let raw_res = List.map (fun (label, pairs) ->
    let tms_base, tms_opt = prep_binop mods pairs in
    bench_compare mods label iterations
      (fun (a, b) -> Mod1.ndiv a b) (fun (a, b) -> Mod2.ndiv a b)
      tms_base tms_opt
  ) groups in
  raw_res;;

(****************************************************************************)
(* 5. Comparison Benchmarks (LT, LE, EQ)                                    *)
(****************************************************************************)

let run_comparison_tests (((module Mod1 : Arith_num_sig), (module Mod2 : Arith_num_sig)) as mods)
    samples iterations =
  Printf.printf "\n====================================================================================================\n";
  Printf.printf " COMPARISON BENCHMARKS (LT, LE, EQ - raw and NUM)\n";
  Printf.printf "====================================================================================================\n";
  let run_cmp_op name uname raw_f1 raw_f2 =
    let groups = [
      (Printf.sprintf "raw_%s (small, small)" name, samples.bin_ss);
      (Printf.sprintf "raw_%s (small, large)" name, samples.bin_sl);
      (Printf.sprintf "raw_%s (large, small)" name, samples.bin_ls);
      (Printf.sprintf "raw_%s (large, large)" name, samples.bin_ll);
      (Printf.sprintf "raw_%s (all combinations)" name, samples.bin_all);
    ] in
    let raw_res = List.map (fun (label, pairs) ->
      let tms_base, tms_opt = prep_binop mods pairs in
      bench_compare mods label iterations (fun (a, b) -> fst (raw_f1 a b)) (fun (a, b) -> fst (raw_f2 a b)) tms_base tms_opt
    ) groups in
    raw_res
  in
  let lt_res = run_cmp_op "lt" "LT" Mod1.nlt Mod2.nlt in
  let le_res = run_cmp_op "le" "LE" Mod1.nle Mod2.nle in
  let eq_res = run_cmp_op "eq" "EQ" Mod1.neq Mod2.neq in
  lt_res @ le_res @ eq_res;;

(****************************************************************************)
(* 6. Unary Operation Benchmarks (SUC, PRE, EQ0, GT0, EVEN, ODD)            *)
(****************************************************************************)

let run_unary_tests (((module Mod1 : Arith_num_sig), (module Mod2 : Arith_num_sig)) as mods)
    samples iterations =
  Printf.printf "\n====================================================================================================\n";
  Printf.printf " UNARY OPERATION BENCHMARKS (SUC, PRE, EQ0, GT0, EVEN, ODD)\n";
  Printf.printf "====================================================================================================\n";
  let m1, m2 = mods in
  let nums = samples.unary_all in
  let raw_terms_base = Array.map (mk_num_term m1) nums in
  let raw_terms_opt  = Array.map (mk_num_term m2) nums in

  (* SUC *)
  let suc_raw_base, suc_raw_opt = prep_unop mods nums in
  let r_suc_raw = bench_compare mods "raw_suc_conv_hash (all)" iterations
    Mod1.nsuc Mod2.nsuc suc_raw_base suc_raw_opt in

  (* PRE *)
  let pre_raw_base, pre_raw_opt = prep_unop mods nums in
  let r_pre_raw = bench_compare mods "raw_pre_hash_conv (all)" iterations
    Mod1.npre Mod2.npre pre_raw_base pre_raw_opt in

  (* EQ0 *)
  let r_eq0_raw = bench_compare mods "raw_eq0_hash_conv (all)" iterations
    (fun t -> fst (Mod1.neq0 t)) (fun t -> fst (Mod2.neq0 t)) raw_terms_base raw_terms_opt in

  (* GT0 *)
  let r_gt0_raw = bench_compare mods "raw_gt0_hash_conv (all)" iterations
    (fun t -> fst (Mod1.ngt0 t)) (fun t -> fst (Mod2.ngt0 t)) raw_terms_base raw_terms_opt in

  (* EVEN *)
  let even_raw_base, even_raw_opt = prep_unop mods nums in
  let r_even_raw = bench_compare mods "raw_even_hash_conv (all)" iterations
    (fun t -> fst (Mod1.neven t)) (fun t -> fst (Mod2.neven t)) even_raw_base even_raw_opt in

  (* ODD *)
  let odd_raw_base, odd_raw_opt = prep_unop mods nums in
  let r_odd_raw = bench_compare mods "raw_odd_hash_conv (all)" iterations
    (fun t -> fst (Mod1.nodd t)) (fun t -> fst (Mod2.nodd t)) odd_raw_base odd_raw_opt in

  [r_suc_raw; r_pre_raw; r_eq0_raw; r_gt0_raw; r_even_raw; r_odd_raw];;

