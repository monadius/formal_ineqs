needs "arith_options.hl";;
Arith_options.base := 100;;

needs "fast_arith/tests/tests_base.hl";;

needs "fast_arith/fast_num.hl";;

(* Adapter wrapping standard HOL Light numeral conversions to match Arith_num_sig *)
module Std_num : Arith_num_sig = struct
  open Misc_vars

  let even_const = standardize_tm `EVEN`
  let odd_const  = standardize_tm `ODD`
  let not_le_imp_le = (UNDISCH_ALL o standardize o ARITH_RULE) `(m <= n <=> F) ==> n <= m`

  let mk_nat = mk_numeral
  let mk_small_nat = mk_small_numeral
  let dest_nat = dest_numeral

  let nsuc tm = NUM_SUC_CONV (mk_comb (suc_op_num, tm))
  let npre tm = NUM_PRE_CONV (mk_comb (pre_op_num, tm))

  let neven tm =
    let th = NUM_EVEN_CONV (mk_comb (even_const, tm)) in
    th, rand (concl th) = t_const

  let nodd tm =
    let th = NUM_ODD_CONV (mk_comb (odd_const, tm)) in
    th, rand (concl th) = t_const

  let neq0 tm =
    let th = NUM_EQ_CONV (mk_binop eq_op_num tm zero_num) in
    th, rand (concl th) = t_const

  let ngt0 tm =
    let th = NUM_LT_CONV (mk_binop lt_op_num zero_num tm) in
    th, rand (concl th) = t_const

  let neq a b =
    let th = NUM_EQ_CONV (mk_binop eq_op_num a b) in
    th, rand (concl th) = t_const

  let nlt a b =
    let th = NUM_LT_CONV (mk_binop lt_op_num a b) in
    th, rand (concl th) = t_const

  let nle a b =
    let th = NUM_LE_CONV (mk_binop le_op_num a b) in
    th, rand (concl th) = t_const

  let nadd a b = NUM_ADD_CONV (mk_binop add_op_num a b)
  let nsub a b = NUM_SUB_CONV (mk_binop sub_op_num a b)

  let nsub_le a b =
    let th_le = NUM_LE_CONV (mk_binop le_op_num b a) in
    if rand (concl th_le) = t_const then
      NUM_SUB_CONV (mk_binop sub_op_num a b), EQT_ELIM th_le, true
    else
      let th_le' = Misc_functions.MY_PROVE_HYP th_le
                     (INST [b, m_var_num; a, n_var_num] not_le_imp_le) in
      NUM_SUB_CONV (mk_binop sub_op_num b a), th_le', false

  let nmul a b = NUM_MULT_CONV (mk_binop mul_op_num a b)
  let ndiv a b = NUM_DIV_CONV (mk_binop div_op_num a b)
end;;

ignore (run_all_tests ~seed:42 ~n_samples:10000 [
  ("HOL_Light", (module Std_num  : Arith_num_sig));
  ("Fast_num",  (module Fast_num : Arith_num_sig));
]);;
