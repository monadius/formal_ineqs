(****************************************************************************)
(* Main Test Runner & Summary Report                                        *)
(****************************************************************************)

let run_all_tests ?(seed = 42) ?(n_samples = 1000) ?(iterations = 1)
    (((module Mod1 : Arith_num_sig), (module Mod2 : Arith_num_sig)) as mods) =
  let samples = generate_sample_set seed n_samples in
  let actual_samples = Array.length samples.unary_all in
  Printf.printf "\n####################################################################################################\n";
  Printf.printf " RUNNING HOL LIGHT NATURAL ARITHMETIC BENCHMARK SUITE\n";
  Printf.printf " Base = %d, Seed = %d, Samples per test = %d, Iterations = %d\n"
    !Arith_options.base seed actual_samples iterations;
  Printf.printf "####################################################################################################\n";

  let r_add   = run_addition_tests mods samples iterations in
  let r_mul   = run_multiplication_tests mods samples iterations in
  let r_sub   = run_subtraction_tests mods samples iterations in
  let r_div   = run_division_tests mods samples iterations in
  let r_cmp   = run_comparison_tests mods samples iterations in
  let r_unary = run_unary_tests mods samples iterations in
  (* let r_help  = run_helper_tests mods samples iterations in *)

  let all_results = r_add @ r_mul @ r_sub @ r_div @ r_cmp @ r_unary in

  let total_base = List.fold_left (fun acc r -> acc +. r.baseline_time) 0.0 all_results in
  let total_opt  = List.fold_left (fun acc r -> acc +. r.optimized_time) 0.0 all_results in
  let overall_speedup = if total_opt > 0.0 then total_base /. total_opt else 0.0 in
  let all_passed = List.for_all (fun r -> r.passed) all_results in

  Printf.printf "\n====================================================================================================\n";
  Printf.printf " BENCHMARK SUMMARY REPORT\n";
  Printf.printf "====================================================================================================\n";
  Printf.printf " Random Seed          : %d\n" seed;
  Printf.printf " Samples per Test     : %d\n" actual_samples;
  Printf.printf " Total Test Groups    : %d\n" (List.length all_results);
  Printf.printf " Verification Status  : %s\n" (if all_passed then "ALL TESTS PASSED (100% equivalence verified)" else "FAILURES DETECTED");
  Printf.printf " Total Baseline Time  : %8.4f s\n" total_base;
  Printf.printf " Total Optimized Time : %8.4f s\n" total_opt;
  Printf.printf " Overall Suite Speedup: %6.2fx\n" overall_speedup;
  Printf.printf "====================================================================================================\n\n";
  flush stdout;
  all_results;;

module Arith_opt : Arith_num_sig = struct
  include Arith_num3
  let neven tm = neven tm, true
  let nodd tm = nodd tm, true
  let neq a b = neq a b, true
  let nlt a b = nlt a b, true
  let nle a b = nle a b, true
end;;

ignore (run_all_tests ~seed:42 ~n_samples:10000
  ((module Nat_arith : Arith_num_sig), (module Arith_opt : Arith_num_sig)));;

(* To run all tests immediately upon loading this file:
   run_all_tests ~seed:42
     ((module Arith_num : Arith_num_sig), (module Arith_num3 : Arith_num_sig));;
*)

